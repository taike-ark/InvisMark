<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvisMark.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ImPagePadding}" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource ImPageTitle}" />

            <Border Style="{StaticResource ImCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="数据位置" Style="{StaticResource ImSectionTitle}" />
                    <TextBlock x:Name="DataText" Text="—" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource ImCaption}"
                               Text="审计链（哈希链）与 trace 索引都存在这个 SQLite 库里；可用环境变量 INVISMARK_DB / INVISMARK_DATA 改位置。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开数据目录" Click="OnOpenClick" />
                        <Button Content="校验审计链" Click="OnVerifyClick" />
                        <TextBlock x:Name="VerifyText" VerticalAlignment="Center" Style="{StaticResource ImCaption}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ImCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="界面外观" Style="{StaticResource ImSectionTitle}" />
                    <TextBlock Style="{StaticResource ImCaption}"
                               Text="主题跟随系统（设置 → 个性化 → 颜色）。窗口会自动启用 Mica / 亚克力背景；远程桌面或老系统下自动降级为纯色。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ImCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" Style="{StaticResource ImSectionTitle}" />
                    <TextBlock Text="隐迹 InvisMark 0.1.0" />
                    <TextBlock Style="{StaticResource ImCaption}" Text="Apache-2.0 ｜ DWT+DCT+扩频+RS(64,24) ｜ 本地离线、图片不出机器" />
                    <TextBlock x:Name="BackendText" Text="后端：—" Style="{StaticResource ImCaption}" />
                    <HyperlinkButton Content="打开 GitHub 仓库"
                                     NavigateUri="https://github.com/taike-ark/InvisMark" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
