<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvisMark.Desktop.Pages.EmbedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ImPagePadding}" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="嵌入水印" Style="{StaticResource ImPageTitle}" />
                <TextBlock Style="{StaticResource ImCaption}"
                           Text="全程在本机完成，图片不上传。输出为无损 PNG，trace_id 写入本地审计库。" />
            </StackPanel>

            <Border Style="{StaticResource ImCard}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PickButton" Grid.Column="0" Content="选择图片" Click="OnPickClick" />
                        <TextBlock x:Name="FileText" Grid.Column="1" VerticalAlignment="Center"
                                   Text="未选择图片（也可以把图片拖进来）" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource ImCaption}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="资源码" VerticalAlignment="Center" />
                        <TextBox x:Name="ResourceBox" Grid.Column="1" MaxLength="6"
                                 PlaceholderText="可留空，自动生成（1–6 位 base36，例如 F13241）" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自定义内容" VerticalAlignment="Center" />
                        <TextBox x:Name="CustomTextBox" Grid.Column="1" MaxLength="13"
                                 PlaceholderText="可选：≤13 字节 UTF-8，约 4 个汉字；留空写标准追溯码" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="EmbedButton" Content="开始嵌入" Style="{StaticResource AccentButtonStyle}"
                                Click="OnEmbedClick" IsEnabled="False" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource ImCaption}" />
                    </StackPanel>

                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultCard" Style="{StaticResource ImCard}" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Text="嵌入结果" Style="{StaticResource ImSectionTitle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="原图" Style="{StaticResource ImCaption}" />
                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image x:Name="BeforeImage" Stretch="Uniform" Height="260" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="带水印成图" Style="{StaticResource ImCaption}" />
                            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image x:Name="AfterImage" Stretch="Uniform" Height="260" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="PSNR" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="PsnrText" Text="—" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="SSIM" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="SsimText" Text="—" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="trace_id（24 字节）" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="TraceText" Text="—" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="复制 trace_id" Click="OnCopyClick" />
                        <Button Content="打开所在文件夹" Click="OnOpenFolderClick" />
                        <TextBlock x:Name="SavedText" VerticalAlignment="Center" Style="{StaticResource ImCaption}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

