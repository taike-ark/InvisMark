<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvisMark.Desktop.Pages.BatchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ImPagePadding}" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="批量处理" Style="{StaticResource ImPageTitle}" />
                <TextBlock Style="{StaticResource ImCaption}"
                           Text="选一个目录，把里面的 PNG/JPG 全部嵌入水印，输出到另一个目录。" />
            </StackPanel>

            <Border Style="{StaticResource ImCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="选择输入目录" Click="OnPickInputClick" />
                        <TextBlock x:Name="InputText" Grid.Column="1" VerticalAlignment="Center"
                                   Text="未选择" TextTrimming="CharacterEllipsis" Style="{StaticResource ImCaption}" />
                        <Button Grid.Column="2" Content="选择输出目录" Click="OnPickOutputClick" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="资源码" VerticalAlignment="Center" />
                        <TextBox x:Name="ResourceBox" Grid.Column="1" MaxLength="6"
                                 PlaceholderText="可留空，自动生成" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RunButton" Content="开始批量嵌入" Style="{StaticResource AccentButtonStyle}"
                                Click="OnRunClick" IsEnabled="False" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource ImCaption}" />
                    </StackPanel>
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border x:Name="ListCard" Style="{StaticResource ImCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="SummaryText" Text="处理结果" Style="{StaticResource ImSectionTitle}" />
                    <ListView x:Name="ResultList" MaxHeight="360" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
