<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InvisMark.Desktop.Pages.DetectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource ImPagePadding}" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="检测溯源" Style="{StaticResource ImPageTitle}" />
                <TextBlock Style="{StaticResource ImCaption}"
                           Text="从被压缩、截图或裁切过的图片里恢复 trace_id；命中后可导出证据包。" />
            </StackPanel>

            <Border Style="{StaticResource ImCard}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PickButton" Grid.Column="0" Content="选择图片" Click="OnPickClick" />
                        <TextBlock x:Name="FileText" Grid.Column="1" VerticalAlignment="Center"
                                   Text="未选择图片（也可以把图片拖进来）" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource ImCaption}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="DetectButton" Content="开始检测" Style="{StaticResource AccentButtonStyle}"
                                Click="OnDetectClick" IsEnabled="False" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource ImCaption}" />
                    </StackPanel>
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultCard" Style="{StaticResource ImCard}" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="ResultIcon" Glyph="&#xE73E;" FontSize="22" />
                        <TextBlock x:Name="ResultTitle" Text="命中" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>

                    <Grid ColumnSpacing="24" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="2">
                            <TextBlock Text="trace_id" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="TraceText" Text="—" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="ResourceLabel" Text="资源编码" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="ResourceText" Text="—" FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="嵌入时间" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="TimeText" Text="—" FontSize="16" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                            <TextBlock Text="置信度" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="ConfidenceText" Text="—" FontSize="16" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                            <TextBlock Text="已纠正字节 / 耗时" Style="{StaticResource ImCaption}" />
                            <TextBlock x:Name="StatsText" Text="—" FontSize="16" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EvidenceButton" Content="生成证据包" Click="OnEvidenceClick" />
                        <Button Content="复制 trace_id" Click="OnCopyClick" />
                        <TextBlock x:Name="HintText" VerticalAlignment="Center" Style="{StaticResource ImCaption}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

