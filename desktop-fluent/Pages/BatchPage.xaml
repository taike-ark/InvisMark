<UserControl x:Class="InvisMark.Desktop.Pages.BatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="1080" HorizontalAlignment="Left">
            <TextBlock Text="批量处理" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageCaption}" Margin="0,6,0,0"
                       Text="选一个目录，把里面的 PNG / JPG 全部嵌入水印，输出到另一个目录。" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="选择输入目录" Style="{StaticResource SecondaryButton}" Click="OnPickInputClick" />
                        <TextBlock x:Name="InputText" Grid.Column="1" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Text="未选择" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="选择输出目录" Style="{StaticResource SecondaryButton}" Click="OnPickOutputClick" />
                        <TextBlock x:Name="OutputText" Grid.Column="1" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Text="默认在输入目录旁建 invisMark-out" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="资源码" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <TextBox x:Name="ResourceBox" Grid.Column="1" Style="{StaticResource TextInput}" MaxLength="6"
                                 Margin="12,0,0,0" VerticalContentAlignment="Center"
                                 ToolTip="留空自动生成" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="RunButton" Content="开始批量嵌入" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="OnRunClick" />
                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Height="4"
                                     VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ListCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" Text="处理结果" Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="ResultList" MaxHeight="360" BorderThickness="0" Background="Transparent" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
