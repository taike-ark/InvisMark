<UserControl x:Class="InvisMark.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="数据位置" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DataText" Style="{StaticResource Body}" Text="—" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="审计哈希链与 trace 索引都在这个 SQLite 库里；可用环境变量 INVISMARK_DB / INVISMARK_DATA 改位置。" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="打开数据目录" Style="{StaticResource SecondaryButton}" Click="OnOpenClick" />
                        <Button Content="校验审计链" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnVerifyClick" />
                        <TextBlock x:Name="VerifyText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="界面外观" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="跟随系统深浅色（设置 → 个性化 → 颜色）；Windows 11 上自动使用圆角窗口。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="隐迹 InvisMark 0.1.0" Style="{StaticResource Body}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Apache-2.0 ｜ DWT + DCT + 扩频 + RS(64,24) ｜ 本地离线，图片不出机器" />
                    <TextBlock x:Name="BackendText" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="后端：—" />
                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink NavigateUri="https://github.com/taike-ark/InvisMark"
                                   RequestNavigate="OnNavigate">打开 GitHub 仓库</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
