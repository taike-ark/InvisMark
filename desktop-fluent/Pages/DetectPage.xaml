<UserControl x:Class="InvisMark.Desktop.Pages.DetectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="1080" HorizontalAlignment="Left">
            <TextBlock Text="检测溯源" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageCaption}" Margin="0,6,0,0"
                       Text="从被压缩、截图或裁切过的图片里恢复 trace_id；命中后可导出证据包。" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="选择图片" Style="{StaticResource SecondaryButton}" Click="OnPickClick" />
                        <TextBlock x:Name="FileText" Grid.Column="1" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="未选择图片（也可以把图片拖进来）" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="DetectButton" Content="开始检测" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="OnDetectClick" />
                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Height="4"
                                     VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ResultIcon" FontFamily="{StaticResource IconFont}" FontSize="22"
                                   Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResultTitle" Text="命中" FontSize="20" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                            <TextBlock Text="trace_id" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TraceText" Text="—" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock x:Name="ResourceLabel" Text="资源编码" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ResourceText" Text="—" Style="{StaticResource Body}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                            <TextBlock Text="嵌入时间" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TimeText" Text="—" Style="{StaticResource Body}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="置信度" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ConfidenceText" Text="—" Style="{StaticResource Body}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                            <TextBlock Text="纠正字节 / 耗时" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="StatsText" Text="—" Style="{StaticResource Body}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="EvidenceButton" Content="生成证据包" Style="{StaticResource SecondaryButton}"
                                IsEnabled="False" Click="OnEvidenceClick" />
                        <Button Content="复制 trace_id" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnCopyClick" />
                        <TextBlock x:Name="HintText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

