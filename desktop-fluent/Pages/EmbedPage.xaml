<UserControl x:Class="InvisMark.Desktop.Pages.EmbedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="1080" HorizontalAlignment="Left">
            <TextBlock Text="嵌入水印" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageCaption}" Margin="0,6,0,0"
                       Text="全程在本机完成，图片不上传。输出无损 PNG，并把 trace_id 写入本地审计库。" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="选择图片" Style="{StaticResource SecondaryButton}" Click="OnPickClick" />
                        <TextBlock x:Name="FileText" Grid.Column="1" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="未选择图片（也可以把图片拖进这个卡片）" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="资源码" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <TextBox x:Name="ResourceBox" Grid.Column="1" Style="{StaticResource TextInput}" MaxLength="6"
                                 Margin="12,0,0,0" VerticalContentAlignment="Center"
                                 ToolTip="留空自动生成；1–6 位 base36，例如 F13241" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自定义内容" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <TextBox x:Name="CustomTextBox" Grid.Column="1" Style="{StaticResource TextInput}" MaxLength="13"
                                 Margin="12,0,0,0" VerticalContentAlignment="Center"
                                 ToolTip="可选；填了就把这段文字嵌进图片（≤13 字节 UTF-8，约 4 个汉字）" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="EmbedButton" Content="开始嵌入" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="OnEmbedClick" />
                        <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Height="4"
                                     VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="嵌入结果" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="原图" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <Border CornerRadius="6" Background="{StaticResource SubtleFillBrush}" Height="240">
                                <Image x:Name="BeforeImage" Stretch="Uniform" Margin="4" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="带水印成图" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <Border CornerRadius="6" Background="{StaticResource SubtleFillBrush}" Height="240">
                                <Image x:Name="AfterImage" Stretch="Uniform" Margin="4" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PSNR" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="PsnrText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SSIM" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="SsimText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="trace_id" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TraceText" Text="—" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="复制 trace_id" Style="{StaticResource SecondaryButton}" Click="OnCopyClick" />
                        <Button Content="打开所在文件夹" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpenFolderClick" />
                        <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

